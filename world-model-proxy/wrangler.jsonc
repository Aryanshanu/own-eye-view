{
  "name": "world-model-proxy",
  "compatibility_date": "2026-09-24",
  "main": "src/index.js",

  // Real-time streaming hub for /live (WebSocket). See src/index.js for details, and
  // the top-level README for the "this may require a paid plan" caveat.
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_FEED_HUB", "class_name": "LiveFeedHub" }
    ]
  },
  "migrations": [
    { "tag": "v1-live-feed-hub", "new_classes": ["LiveFeedHub"] }
  ]

  // Optional secret for the ships (AIS) feed — without it, ships simply stay empty:
  //   npx wrangler secret put AISSTREAM_API_KEY
}
